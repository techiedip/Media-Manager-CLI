# Copy to .env and fill in. Values here override media-manager/api-keys/*.txt.

# TMDB API key (v3) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TVDB API key (v4) — https://thetvdb.com/api-information  (PIN only for user-supported keys)
TVDB_API_KEY=
TVDB_PIN=

# Fanart.tv personal API key — https://fanart.tv/get-an-api-key/
FANARTTV_API_KEY=

# OpenSubtitles.com — consumer key from https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Comma-separated ISO 639-1 codes
MM_SUBTITLE_LANGUAGES=en
MM_LANGUAGE=en-US
